      "Bash(findstr apps/api/.env.staging.local)",
      "Bash(findstr apps/web/.env)",
      "PowerShell(cat .env)",
      "PowerShell(cat apps/api/.env)",
      "PowerShell(cat apps/api/.env.staging.local)",
      "PowerShell(cat apps/web/.env)",
      "PowerShell(type .env)",
      "PowerShell(type apps/api/.env)",
      "PowerShell(type apps/api/.env.staging.local)",
      "PowerShell(type apps/web/.env)",
      "PowerShell(more .env)",
      "PowerShell(more apps/api/.env)",
      "PowerShell(more apps/api/.env.staging.local)",
      "PowerShell(more apps/web/.env)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content apps/api/.env)",
      "PowerShell(Get-Content apps/api/.env.staging.local)",
      "PowerShell(Get-Content apps/web/.env)",
      "PowerShell(findstr .env)",
      "PowerShell(findstr apps/api/.env)",
      "PowerShell(findstr apps/api/.env.staging.local)",
      "PowerShell(findstr apps/web/.env)"
    ]
  }
}
