      "Edit(apps/api/.env.staging.local)",
      "Read(apps/web/.env)",
      "Edit(apps/web/.env)",
      "Bash(cat .env)",
      "Bash(cat apps/api/.env)",
      "Bash(cat apps/api/.env.staging.local)",
      "Bash(cat apps/web/.env)",
      "Bash(type .env)",
      "Bash(type apps/api/.env)",
      "Bash(type apps/api/.env.staging.local)",
      "Bash(type apps/web/.env)",
      "Bash(more .env)",
      "Bash(more apps/api/.env)",
      "Bash(more apps/api/.env.staging.local)",
      "Bash(more apps/web/.env)",
      "Bash(Get-Content .env)",
      "Bash(Get-Content apps/api/.env)",
      "Bash(Get-Content apps/api/.env.staging.local)",
      "Bash(Get-Content apps/web/.env)",
      "Bash(findstr .env)",
