{
  "name": "growspark-sales-crm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prepare": "pnpm --filter @growspark/shared build",
    "dev": "pnpm --filter @growspark/shared build && pnpm -r --parallel dev",
    "build": "pnpm --filter @growspark/shared build && pnpm -r build",
    "typecheck": "pnpm --filter @growspark/shared build && pnpm -r typecheck",
    "lint": "pnpm --filter @growspark/shared build && pnpm -r lint",
    "test": "pnpm --filter @growspark/shared build && pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "10.15.0",
    "typescript-eslint": "8.73.0",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "@types/node": "22.20.5"
  }
}
