# Dev-only values. Never use these credentials outside a local machine.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://growspark_dev:growspark_dev_password@127.0.0.1:5433/crm_dev
TEST_DATABASE_URL=postgresql://growspark_dev:growspark_dev_password@127.0.0.1:5433/crm_test

# Seed-only, dev-only passwords for the two demo users (admin@growspark.test,
# staff@growspark.test). No default exists in code — the seed refuses to run
# without these set. Never use these values outside a local machine.
SEED_ADMIN_PASSWORD=dev-only-admin-password
SEED_STAFF_PASSWORD=dev-only-staff-password
