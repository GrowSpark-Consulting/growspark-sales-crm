# Dev-only values. Never use these credentials outside a local machine.
NODE_ENV=development
# Required for `pnpm db:seed:sample` to run locally — it refuses unless this
# is exactly "local" or "staging" (with --confirm and a matching schema); see
# docs/decisions.md D64 and src/lib/sample-seed-guard.ts. If your own real
# apps/api/.env doesn't have this line yet, add it.
APP_ENV=local
PORT=4000
DATABASE_URL=postgresql://growspark_dev:growspark_dev_password@127.0.0.1:5433/crm_dev
TEST_DATABASE_URL=postgresql://growspark_dev:growspark_dev_password@127.0.0.1:5433/crm_test

# Leave unset here. Staging (apps/api/.env.staging.local, not this file) sets
# this to "sales" so the Prisma adapter targets that schema at runtime — see
# docs/decisions.md D58. It MUST exactly match DATABASE_URL's own ?schema=
# query param (DATABASE_URL=...?schema=sales there too); the app refuses to
# start if they disagree (D59), and local dev/test additionally refuse to
# start if DATABASE_URL does not point at localhost/127.0.0.1/::1.
# DATABASE_SCHEMA=sales

# pg.Pool's own default (10) when unset, used here in local dev. Staging sets
# this to 5 — Supabase's free tier has few connections available.
# DATABASE_POOL_MAX=10

# Unset here (no TLS config passed to pg at all; local Postgres has none). In
# staging, a file path or pasted PEM content verifying Supabase's certificate
# chain. DATABASE_SSL_REJECT_UNAUTHORIZED=false is a deliberately insecure
# escape hatch, only if that verification cannot be made to work — never the
# default. See apps/api/src/lib/database-ssl.ts and docs/STAGING.md.
# DATABASE_SSL_CA=
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Comma-separated list of origins allowed to make cross-origin-checked writes
# (POST/PUT/PATCH/DELETE). The web app's own origin, reached through its
# same-origin /api/* proxy.
ALLOWED_ORIGINS=http://localhost:3000

# "false" in local dev (direct connections, no proxy in front of this
# process). A non-negative integer (hop count) once this API sits behind a
# real reverse proxy, so Express trusts that many X-Forwarded-* hops and
# req.ip reflects the real client instead of the proxy.
TRUST_PROXY=false

# How long a session cookie/row stays valid (sliding — extended on activity).
SESSION_TTL_DAYS=7

# Seed-only, dev-only passwords for the two demo users (admin@growspark.test,
# staff@growspark.test). No default exists in code — the seed refuses to run
# without these set. Never use these values outside a local machine.
SEED_ADMIN_PASSWORD=dev-only-admin-password
SEED_STAFF_PASSWORD=dev-only-staff-password
