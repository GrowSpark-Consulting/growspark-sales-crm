    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "eslint": "10.15.0",
    "typescript-eslint": "8.73.0",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
