{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:verify-fresh": "tsx scripts/db-verify-fresh.ts",
    "db:seed:sample": "tsx --env-file=.env scripts/db-seed-sample.ts",
    "org:set-details": "tsx --env-file=.env scripts/set-org-details.ts",
    "staging:migrate": "tsx scripts/staging-migrate.ts",
    "staging:create-admin": "tsx scripts/staging-create-admin.ts",
    "staging:seed-sample": "tsx scripts/staging-seed-sample.ts",
    "staging:set-org-details": "tsx scripts/staging-set-org-details.ts",
    "staging:check-db": "tsx scripts/staging-check-db.ts"
  },
  "dependencies": {
    "@growspark/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie": "2.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
