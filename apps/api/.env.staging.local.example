# Template only — placeholders, no real values. Copy this file to
# apps/api/.env.staging.local (NOT .env.staging — see docs/decisions.md)
# and fill in the real Supabase/Render values there. .env.staging.local is
# git-ignored and this tool will never read, create, edit or delete it —
# only you do. See docs/STAGING.md for the full walkthrough.

# Must be exactly "production" — this is what exempts the local-only
# database host guard (src/env.ts) for a script that is supposed to be
# targeting Supabase, not local Docker Postgres. The real Render deployment
# also runs with NODE_ENV=production.
NODE_ENV=production

# Distinct from NODE_ENV — this is what tells staging apart from the real
# Render production deployment (both run with NODE_ENV=production). Required
# for `pnpm staging:seed-sample -- --confirm` to run at all; see
# docs/decisions.md D64.
APP_ENV=staging

PORT=4000

# The Supabase project's SESSION POOLER connection string (port 5432, not the
# transaction pooler's 6543) — Prisma 7 + @prisma/adapter-pg needs a session
# connection, not a transaction one. The ?schema=sales query param steers
# `prisma migrate deploy` and where _prisma_migrations lands; it must match
# DATABASE_SCHEMA below exactly, or every staging script refuses to start
# (docs/decisions.md D59).
DATABASE_URL=postgresql://sales_app:REPLACE_WITH_REAL_PASSWORD@REPLACE_WITH_REAL_POOLER_HOST:5432/postgres?schema=sales

# Must match DATABASE_URL's ?schema= param above exactly. This is what
# apps/api/src/db/prisma.ts passes to the Prisma adapter's own `schema`
# option so the running app's queries — not just migrations — actually
# target the "sales" schema (docs/decisions.md D58).
DATABASE_SCHEMA=sales

# Supabase's free tier has few connections available; keep this small.
DATABASE_POOL_MAX=5

# Not needed in practice — confirmed working against the real Supabase
# session pooler with neither of these set (docs/decisions.md D65/D66).
# DATABASE_URL's own sslmode=require (Supabase includes this in the
# connection string it gives you) already gets full certificate verification
# from the installed pg-connection-string version, because it currently
# treats "require" as an alias for "verify-full" — but that's a version-
# specific behaviour slated to change in a future major version to the
# weaker standard libpq meaning (encrypt-only, no verification). For a
# version-proof guarantee that never depends on which pg-connection-string
# version is installed, change DATABASE_URL above to use
# &sslmode=verify-full explicitly instead of &sslmode=require — functionally
# identical today, immune to that future change. Only set DATABASE_SSL_CA if
# certificate verification then actually fails. Never set
# DATABASE_SSL_REJECT_UNAUTHORIZED=false unless every other option has
# failed — and if you ever do, add a decisions.md entry explaining why.
# DATABASE_SSL_CA=
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# The Render web app's own URL (https://<your-app>.onrender.com, or a custom
# domain) — the one origin allowed to make cross-origin-checked writes.
ALLOWED_ORIGINS=https://REPLACE_WITH_REAL_RENDER_WEB_URL

# Stays false even on Render — see docs/decisions.md D60 for why (Next.js's
# rewrites() proxy still forwards neither X-Forwarded-For nor
# X-Forwarded-Proto, the same finding as D21, regardless of hosting platform).
TRUST_PROXY=false

SESSION_TTL_DAYS=7

# Staging must NEVER get the two local-dev demo accounts
# (admin@growspark.test / staff@growspark.test) — do not set
# SEED_ADMIN_PASSWORD or SEED_STAFF_PASSWORD here. The first Admin is created
# interactively instead: pnpm staging:create-admin.
